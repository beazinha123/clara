# INSS- Clara

Crie um arquivo chamado `index.html` no GitHub e cole o código abaixo.

```html
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TJ-OS Multi Edital</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
}

:root{
--bg:#f5f7fb;
--card:#ffffff;
--text:#111827;
--border:#e5e7eb;
--muted:#6b7280;
--primary:#111827;
--blue:#3b82f6;
--green:#16a34a;
--yellow:#eab308;
--red:#dc2626;
}

body{
font-family:'DM Sans',sans-serif;
background:var(--bg);
color:var(--text);
}

h1,h2,h3,h4,button{
font-family:'Outfit',sans-serif;
}

.container{
max-width:1400px;
margin:auto;
padding:25px;
}

.top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:20px;
flex-wrap:wrap;
gap:20px;
}

.card{
background:var(--card);
padding:20px;
border-radius:18px;
border:1px solid var(--border);
box-shadow:0 4px 10px rgba(0,0,0,.05);
}

.tabs{
display:flex;
gap:10px;
margin-bottom:20px;
flex-wrap:wrap;
}

.tab-btn{
padding:12px 18px;
border:none;
border-radius:12px;
background:white;
cursor:pointer;
font-weight:600;
border:1px solid var(--border);
}

.tab-btn.active{
background:var(--primary);
color:white;
}

.tab-content{
display:none;
}

.tab-content.active{
display:block;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:20px;
}

input,select{
width:100%;
padding:12px;
border-radius:10px;
border:1px solid var(--border);
margin-top:10px;
margin-bottom:10px;
font-family:'DM Sans';
}

button.action{
background:var(--primary);
color:white;
padding:12px 16px;
border:none;
border-radius:10px;
cursor:pointer;
}

.edital-item{
padding:15px;
border:1px solid var(--border);
border-radius:14px;
margin-top:10px;
}

.badge{
padding:5px 10px;
border-radius:999px;
font-size:.75rem;
font-weight:700;
color:white;
}

.blue{background:var(--blue);}
.green{background:var(--green);}
.yellow{background:var(--yellow);}
.red{background:var(--red);}

.kanban{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:20px;
}

.column{
background:white;
padding:15px;
border-radius:16px;
border:1px solid var(--border);
min-height:400px;
}

.task{
background:#f9fafb;
padding:14px;
border-radius:12px;
border:1px solid var(--border);
margin-bottom:10px;
cursor:grab;
}

@media(max-width:768px){
.kanban{
grid-template-columns:1fr;
}
}
</style>
</head>
<body>

<div class="container">

<div class="top">
<div>
<h1>TJ-OS Multi Edital</h1>
<p>Sistema inteligente de estudos para concursos</p>
</div>

<div class="card">
<h3>Countdown</h3>
<p id="countdown">Carregando...</p>
</div>
</div>

<div class="tabs">
<button class="tab-btn active" onclick="openTab('dashboard',event)">Dashboard</button>
<button class="tab-btn" onclick="openTab('planejamento',event)">Planejamento</button>
<button class="tab-btn" onclick="openTab('materias',event)">Matérias</button>
<button class="tab-btn" onclick="openTab('tempo',event)">Tempo</button>
<button class="tab-btn" onclick="openTab('edital',event)">Edital</button>
</div>

<div id="dashboard" class="tab-content active">
<div class="grid">
<div class="card">
<h3>Concurso Ativo</h3>
<p id="concursoAtivo">Nenhum edital selecionado</p>
</div>

<div class="card">
<h3>Progresso</h3>
<p id="progresso">0%</p>
</div>

<div class="card">
<h3>Horas Estudadas</h3>
<p id="horasTotal">00:00h</p>
</div>
</div>
</div>

<div id="planejamento" class="tab-content">
<div class="kanban">

<div class="column" ondrop="drop(event)" ondragover="allowDrop(event)">
<h3>Iniciado</h3>
<div class="task" draggable="true" id="task1" ondragstart="drag(event)">
Português - Interpretação
</div>
</div>

<div class="column" ondrop="drop(event)" ondragover="allowDrop(event)">
<h3>Revisar</h3>
</div>

<div class="column" ondrop="drop(event)" ondragover="allowDrop(event)">
<h3>Finalizado</h3>
</div>

</div>
</div>

<div id="materias" class="tab-content">
<div class="card">
<h3>Adicionar Matéria</h3>

<input type="text" id="novaMateria" placeholder="Nome da matéria">

<select id="incidencia">
<option>Alta</option>
<option>Média</option>
<option>Baixa</option>
</select>

<button class="action" onclick="addMateria()">
Adicionar Matéria
</button>

<div id="listaMaterias"></div>
</div>
</div>

<div id="tempo" class="tab-content">
<div class="card">
<h3>Tempo de Estudos</h3>

<input type="time" id="horas">
<input type="number" id="questoes" placeholder="Questões">
<input type="number" id="erros" placeholder="Erros">

<button class="action" onclick="salvarTempo()">
Salvar
</button>

<div id="historico"></div>
</div>
</div>

<div id="edital" class="tab-content">
<div class="card">
<h3>Novo Edital</h3>

<input type="text" id="nomeConcurso" placeholder="Nome do concurso">
<input type="text" id="banca" placeholder="Banca">
<input type="text" id="cargo" placeholder="Cargo">
<input type="date" id="dataProva">

<button class="action" onclick="addEdital()">
Salvar Edital
</button>

<div id="listaEditais"></div>
</div>
</div>

</div>

<script>

function openTab(tab,event){

 document.querySelectorAll('.tab-content')
 .forEach(el=>el.classList.remove('active'));

 document.querySelectorAll('.tab-btn')
 .forEach(el=>el.classList.remove('active'));

 document.getElementById(tab)
 .classList.add('active');

 event.target.classList.add('active');
}

let editais = JSON.parse(localStorage.getItem('editais')) || [];
let materias = JSON.parse(localStorage.getItem('materias')) || [];
let tempos = JSON.parse(localStorage.getItem('tempos')) || [];

function salvarDados(){
localStorage.setItem('editais',JSON.stringify(editais));
localStorage.setItem('materias',JSON.stringify(materias));
localStorage.setItem('tempos',JSON.stringify(tempos));
}

function addEdital(){

const edital = {
nome:document.getElementById('nomeConcurso').value,
banca:document.getElementById('banca').value,
cargo:document.getElementById('cargo').value,
data:document.getElementById('dataProva').value
};

editais.push(edital);
salvarDados();
renderEditais();
}

function renderEditais(){

const lista = document.getElementById('listaEditais');
lista.innerHTML = '';

editais.forEach((e,index)=>{

lista.innerHTML += `
<div class="edital-item">
<h4>${e.nome}</h4>
<p>${e.banca}</p>
<p>${e.cargo}</p>
<p>${e.data}</p>

<button class="action" onclick="selecionarEdital(${index})">
Selecionar
</button>

<button class="action" onclick="deletarEdital(${index})">
Excluir
</button>
</div>
`;

});
}

function selecionarEdital(index){

localStorage.setItem('ativo',JSON.stringify(editais[index]));

const ativo = editais[index];

document.getElementById('concursoAtivo').innerText = ativo.nome;

atualizarCountdown(ativo.data);
}

function deletarEdital(index){

if(confirm('Deseja excluir este edital?')){
editais.splice(index,1);
salvarDados();
renderEditais();
}
}

function atualizarCountdown(data){

const prova = new Date(data);
const hoje = new Date();

const dias = Math.ceil((prova-hoje)/(1000*60*60*24));

document.getElementById('countdown').innerText =
`${dias} dias para a prova`;
}

function addMateria(){

const materia = {
nome:document.getElementById('novaMateria').value,
incidencia:document.getElementById('incidencia').value
};

materias.push(materia);

salvarDados();
renderMaterias();
}

function renderMaterias(){

const lista = document.getElementById('listaMaterias');
lista.innerHTML='';

materias.forEach((m,index)=>{

let cor = 'blue';

if(m.incidencia==='Média') cor='yellow';
if(m.incidencia==='Baixa') cor='red';

lista.innerHTML += `
<div class="edital-item">
<h4>${m.nome}</h4>
<span class="badge ${cor}">${m.incidencia}</span>

<button class="action" onclick="removerMateria(${index})">
Excluir
</button>
</div>
`;
});
}

function removerMateria(index){

if(confirm('Excluir matéria?')){
materias.splice(index,1);
salvarDados();
renderMaterias();
}
}

function salvarTempo(){

const horas = document.getElementById('horas').value;
const questoes = Number(document.getElementById('questoes').value);
const erros = Number(document.getElementById('erros').value);

const percentual = (((questoes-erros)/questoes)*100).toFixed(1);

const registro = {
horas,
questoes,
erros,
percentual
};

tempos.push(registro);

salvarDados();
renderTempo();
}

function renderTempo(){

const historico = document.getElementById('historico');
historico.innerHTML='';

let totalMinutos = 0;

tempos.forEach(t=>{

const partes = t.horas.split(':');
const minutos = Number(partes[0])*60 + Number(partes[1]);

totalMinutos += minutos;

let cor='green';

if(t.percentual < 70) cor='red';
else if(t.percentual <=80) cor='yellow';

historico.innerHTML += `
<div class="edital-item">
<p>Horas: ${t.horas}</p>
<p>Questões: ${t.questoes}</p>
<p class="${cor}">Acertos: ${t.percentual}%</p>
</div>
`;
});

const h = Math.floor(totalMinutos/60);
const m = totalMinutos%60;

document.getElementById('horasTotal').innerText =
`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}h`;
}

function allowDrop(ev){
ev.preventDefault();
}

function drag(ev){
ev.dataTransfer.setData('text',ev.target.id);
}

function drop(ev){

 ev.preventDefault();

 const data = ev.dataTransfer.getData('text');

 const card = document.getElementById(data);

 if(ev.target.classList.contains('column')){
 ev.target.appendChild(card);
 }
}

renderEditais();
renderMaterias();
renderTempo();

const ativo = JSON.parse(localStorage.getItem('ativo'));

if(ativo){
document.getElementById('concursoAtivo').innerText = ativo.nome;
atualizarCountdown(ativo.data);
}

</script>
</body>
</html>
```

Depois:

1. Salve;
2. Faça commit no GitHub;
3. Ative GitHub Pages;
4. O sistema ficará online.
