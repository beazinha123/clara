<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>INSS Clara </title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    :root{
      --bg:#f4f7fb;
      --card:#ffffff;
      --text:#111827;
      --muted:#6b7280;
      --border:#e5e7eb;
      --primary:#2563eb;

      --green:#16a34a;
      --yellow:#eab308;
      --red:#dc2626;

      --shadow:0 4px 14px rgba(0,0,0,.06);
    }

    body.dark{
      --bg:#0f172a;
      --card:#111827;
      --text:#f3f4f6;
      --muted:#94a3b8;
      --border:#1f2937;
      --shadow:0 4px 14px rgba(0,0,0,.4);
    }

    body{
      background:var(--bg);
      color:var(--text);
      font-family:'DM Sans',sans-serif;
      transition:.3s;
    }

    h1,h2,h3,h4,button{
      font-family:'Outfit',sans-serif;
    }

    .container{
      max-width:1500px;
      margin:auto;
      padding:25px;
    }

    .topbar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:25px;
      gap:20px;
      flex-wrap:wrap;
    }

    .title h1{
      font-size:2rem;
    }

    .title p{
      color:var(--muted);
    }

    .card{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:20px;
      padding:20px;
      box-shadow:var(--shadow);
    }

    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:20px;
    }

    .tabs{
      display:flex;
      gap:10px;
      margin:25px 0;
      flex-wrap:wrap;
    }

    .tab-btn{
      border:none;
      padding:12px 18px;
      border-radius:12px;
      cursor:pointer;
      background:var(--card);
      color:var(--text);
      border:1px solid var(--border);
      font-weight:600;
    }

    .tab-btn.active{
      background:var(--primary);
      color:white;
    }

    .tab{
      display:none;
    }

    .tab.active{
      display:block;
    }

    input,select,textarea{
      width:100%;
      margin-top:10px;
      margin-bottom:10px;
      padding:12px;
      border-radius:12px;
      border:1px solid var(--border);
      background:var(--card);
      color:var(--text);
      font-family:'DM Sans';
    }

    button.action{
      background:var(--primary);
      color:white;
      border:none;
      padding:12px 16px;
      border-radius:12px;
      cursor:pointer;
      margin-top:10px;
    }

    .kanban{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
    }

    .column{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:20px;
      padding:15px;
      min-height:500px;
    }

    .task{
      background:var(--bg);
      border:1px solid var(--border);
      border-radius:14px;
      padding:14px;
      margin-bottom:10px;
      cursor:grab;
    }

    .badge{
      display:inline-block;
      padding:5px 10px;
      border-radius:999px;
      font-size:.75rem;
      font-weight:700;
      color:white;
      margin-top:8px;
    }

    .green{
      background:var(--green);
    }

    .yellow{
      background:var(--yellow);
      color:black;
    }

    .red{
      background:var(--red);
    }

    .blue{
      background:var(--primary);
    }

    .item{
      background:var(--card);
      border:1px solid var(--border);
      border-radius:16px;
      padding:16px;
      margin-top:12px;
    }

    .actions{
      display:flex;
      gap:10px;
      margin-top:10px;
      flex-wrap:wrap;
    }

    .small{
      padding:8px 12px;
      border:none;
      border-radius:10px;
      cursor:pointer;
    }

    .delete{
      background:var(--red);
      color:white;
    }

    .edit{
      background:var(--yellow);
    }

    .stats{
      font-size:2rem;
      font-weight:700;
      margin-top:10px;
    }

    canvas{
      margin-top:20px;
      background:var(--card);
      border-radius:20px;
      padding:15px;
    }

    @media(max-width:900px){

      .kanban{
        grid-template-columns:1fr;
      }

    }

  </style>
</head>
<body>

<div class="container">

  <div class="topbar">

    <div class="title">
      <h1>StudyOS Multi Edital</h1>
      <p>Plataforma inteligente de estudos</p>
    </div>

    <div class="card">
      <h3>Countdown</h3>
      <p id="countdown">Nenhuma prova selecionada</p>

      <button class="action" onclick="toggleDark()">
        Dark Mode
      </button>
    </div>

  </div>

  <div class="tabs">

    <button class="tab-btn active" onclick="openTab('dashboard',event)">
      Dashboard
    </button>

    <button class="tab-btn" onclick="openTab('planejamento',event)">
      Planejamento
    </button>

    <button class="tab-btn" onclick="openTab('materias',event)">
      Matérias
    </button>

    <button class="tab-btn" onclick="openTab('tempo',event)">
      Tempo
    </button>

    <button class="tab-btn" onclick="openTab('edital',event)">
      Edital
    </button>

  </div>

  <!-- DASHBOARD -->

  <div id="dashboard" class="tab active">

    <div class="grid">

      <div class="card">
        <h3>Edital Ativo</h3>
        <div class="stats" id="ativoNome">
          Nenhum
        </div>
      </div>

      <div class="card">
        <h3>Horas Estudadas</h3>
        <div class="stats" id="horasTotal">
          00:00h
        </div>
      </div>

      <div class="card">
        <h3>Matérias</h3>
        <div class="stats" id="totalMaterias">
          0
        </div>
      </div>

      <div class="card">
        <h3>Questões</h3>
        <div class="stats" id="totalQuestoes">
          0
        </div>
      </div>

    </div>

    <canvas id="graficoHoras"></canvas>

  </div>

  <!-- PLANEJAMENTO -->

  <div id="planejamento" class="tab">

    <div class="card">

      <h3>Adicionar Tópico</h3>

      <input type="text" id="tituloTask" placeholder="Título">

      <select id="tipoEstudo">
        <option>Questões</option>
        <option>Aula</option>
        <option>Leitura</option>
      </select>

      <button class="action" onclick="addTask()">
        Adicionar
      </button>

    </div>

    <br>

    <div class="kanban">

      <div class="column"
      ondrop="drop(event)"
      ondragover="allowDrop(event)"
      data-status="Iniciado">

        <h3>Iniciado</h3>

      </div>

      <div class="column"
      ondrop="drop(event)"
      ondragover="allowDrop(event)"
      data-status="Revisar">

        <h3>Revisar</h3>

      </div>

      <div class="column"
      ondrop="drop(event)"
      ondragover="allowDrop(event)"
      data-status="Finalizado">

        <h3>Finalizado</h3>

      </div>

    </div>

  </div>

  <!-- MATÉRIAS -->

  <div id="materias" class="tab">

    <div class="card">

      <h3>Nova Matéria</h3>

      <input type="text" id="materiaNome" placeholder="Nome da matéria">

      <select id="incidencia">
        <option>Alta</option>
        <option>Média</option>
        <option>Baixa</option>
      </select>

      <button class="action" onclick="addMateria()">
        Adicionar
      </button>

      <div id="listaMaterias"></div>

    </div>

  </div>

  <!-- TEMPO -->

  <div id="tempo" class="tab">

    <div class="card">

      <h3>Tempo de Estudos</h3>

      <input type="time" id="horas">

      <input type="number" id="questoes" placeholder="Questões">

      <input type="number" id="erros" placeholder="Erros">

      <button class="action" onclick="salvarTempo()">
        Salvar
      </button>

      <div id="historico"></div>

    </div>

  </div>

  <!-- EDITAL -->

  <div id="edital" class="tab">

    <div class="card">

      <h3>Novo Edital</h3>

      <input type="text" id="nomeEdital" placeholder="Nome">

      <input type="text" id="banca" placeholder="Banca">

      <input type="text" id="cargo" placeholder="Cargo">

      <input type="date" id="dataProva">

      <button class="action" onclick="addEdital()">
        Salvar Edital
      </button>

      <div id="listaEditais"></div>

    </div>

  </div>

</div>

<script>

  function openTab(tab,event){

    document.querySelectorAll('.tab')
    .forEach(t=>t.classList.remove('active'));

    document.querySelectorAll('.tab-btn')
    .forEach(b=>b.classList.remove('active'));

    document.getElementById(tab)
    .classList.add('active');

    event.target.classList.add('active');
  }

  function toggleDark(){

    document.body.classList.toggle('dark');

    localStorage.setItem(
      'dark',
      document.body.classList.contains('dark')
    );
  }

  if(localStorage.getItem('dark') === 'true'){
    document.body.classList.add('dark');
  }

  let materias =
  JSON.parse(localStorage.getItem('materias')) || [];

  let editais =
  JSON.parse(localStorage.getItem('editais')) || [];

  let tempos =
  JSON.parse(localStorage.getItem('tempos')) || [];

  let tasks =
  JSON.parse(localStorage.getItem('tasks')) || [];

  function salvarTudo(){

    localStorage.setItem(
      'materias',
      JSON.stringify(materias)
    );

    localStorage.setItem(
      'editais',
      JSON.stringify(editais)
    );

    localStorage.setItem(
      'tempos',
      JSON.stringify(tempos)
    );

    localStorage.setItem(
      'tasks',
      JSON.stringify(tasks)
    );
  }

  // EDITAIS

  function addEdital(){

    const edital = {

      nome:
      document.getElementById('nomeEdital').value,

      banca:
      document.getElementById('banca').value,

      cargo:
      document.getElementById('cargo').value,

      data:
      document.getElementById('dataProva').value
    };

    editais.push(edital);

    salvarTudo();

    renderEditais();
  }

  function renderEditais(){

    const lista =
    document.getElementById('listaEditais');

    lista.innerHTML='';

    editais.forEach((e,index)=>{

      lista.innerHTML += `

      <div class="item">

        <h4>${e.nome}</h4>

        <p>${e.banca}</p>

        <p>${e.cargo}</p>

        <p>${e.data}</p>

        <div class="actions">

          <button class="small blue"
          onclick="selecionarEdital(${index})">

            Selecionar

          </button>

          <button class="small delete"
          onclick="deletarEdital(${index})">

            Excluir

          </button>

        </div>

      </div>

      `;
    });
  }

  function selecionarEdital(index){

    localStorage.setItem(
      'ativo',
      JSON.stringify(editais[index])
    );

    atualizarDashboard();
  }

  function deletarEdital(index){

    if(confirm('Excluir edital?')){

      editais.splice(index,1);

      salvarTudo();

      renderEditais();
    }
  }

  // MATÉRIAS

  function addMateria(){

    const materia = {

      nome:
      document.getElementById('materiaNome').value,

      incidencia:
      document.getElementById('incidencia').value
    };

    materias.push(materia);

    salvarTudo();

    renderMaterias();
  }

  function renderMaterias(){

    const lista =
    document.getElementById('listaMaterias');

    lista.innerHTML='';

    document.getElementById('totalMaterias')
    .innerText = materias.length;

    materias.forEach((m,index)=>{

      let cor='green';

      if(m.incidencia==='Média') cor='yellow';
      if(m.incidencia==='Baixa') cor='red';

      lista.innerHTML += `

      <div class="item">

        <h4>${m.nome}</h4>

        <span class="badge ${cor}">
          ${m.incidencia}
        </span>

        <div class="actions">

          <button class="small delete"
          onclick="deleteMateria(${index})">

            Excluir

          </button>

        </div>

      </div>

      `;
    });
  }

  function deleteMateria(index){

    if(confirm('Excluir matéria?')){

      materias.splice(index,1);

      salvarTudo();

      renderMaterias();
    }
  }

  // TEMPO

  function salvarTempo(){

    const horas =
    document.getElementById('horas').value;

    const questoes =
    Number(document.getElementById('questoes').value);

    const erros =
    Number(document.getElementById('erros').value);

    const percentual =
    (((questoes-erros)/questoes)*100).toFixed(1);

    tempos.push({
      horas,
      questoes,
      erros,
      percentual
    });

    salvarTudo();

    renderTempo();

    atualizarDashboard();
  }

  function renderTempo(){

    const historico =
    document.getElementById('historico');

    historico.innerHTML='';

    let totalQuestoes = 0;

    tempos.forEach(t=>{

      totalQuestoes += t.questoes;

      let cor='green';

      if(t.percentual < 70) cor='red';
      else if(t.percentual <=80) cor='yellow';

      historico.innerHTML += `

      <div class="item">

        <p>Horas: ${t.horas}</p>

        <p>Questões: ${t.questoes}</p>

        <span class="badge ${cor}">
          ${t.percentual}%
        </span>

      </div>

      `;
    });

    document.getElementById('totalQuestoes')
    .innerText = totalQuestoes;
  }

  // TASKS

  function addTask(){

    const titulo =
    document.getElementById('tituloTask').value;

    const tipo =
    document.getElementById('tipoEstudo').value;

    const id =
    Date.now();

    tasks.push({
      id,
      titulo,
      tipo,
      status:'Iniciado'
    });

    salvarTudo();

    renderTasks();
  }

  function renderTasks(){

    document.querySelectorAll('.column')
    .forEach(c=>{

      c.querySelectorAll('.task')
      .forEach(t=>t.remove());
    });

    tasks.forEach(task=>{

      const div =
      document.createElement('div');

      div.className='task';

      div.draggable=true;

      div.id=task.id;

      div.ondragstart=drag;

      div.innerHTML = `

      <h4>${task.titulo}</h4>

      <span class="badge blue">
        ${task.tipo}
      </span>

      <div class="actions">

        <button class="small delete"
        onclick="deleteTask(${task.id})">

          Excluir

        </button>

      </div>

      `;

      const coluna =
      [...document.querySelectorAll('.column')]
      .find(c=>c.dataset.status===task.status);

      coluna.appendChild(div);
    });
  }

  function deleteTask(id){

    if(confirm('Excluir tópico?')){

      tasks =
      tasks.filter(t=>t.id !== id);

      salvarTudo();

      renderTasks();
    }
  }

  function allowDrop(ev){
    ev.preventDefault();
  }

  function drag(ev){
    ev.dataTransfer.setData(
      'text',
      ev.target.id
    );
  }

  function drop(ev){

    ev.preventDefault();

    const id =
    ev.dataTransfer.getData('text');

    const card =
    document.getElementById(id);

    const coluna =
    ev.currentTarget;

    coluna.appendChild(card);

    const status =
    coluna.dataset.status;

    tasks = tasks.map(t=>{

      if(t.id == id){
        t.status = status;
      }

      return t;
    });

    salvarTudo();
  }

  // DASHBOARD

  function atualizarDashboard(){

    const ativo =
    JSON.parse(localStorage.getItem('ativo'));

    if(ativo){

      document.getElementById('ativoNome')
      .innerText = ativo.nome;

      const prova =
      new Date(ativo.data);

      const hoje =
      new Date();

      const dias =
      Math.ceil(
        (prova-hoje)/(1000*60*60*24)
      );

      document.getElementById('countdown')
      .innerText =
      `${dias} dias para a prova`;
    }

    let totalMin = 0;

    tempos.forEach(t=>{

      const p = t.horas.split(':');

      totalMin +=
      Number(p[0])*60 + Number(p[1]);
    });

    const h =
    Math.floor(totalMin/60);

    const m =
    totalMin%60;

    document.getElementById('horasTotal')
    .innerText =
    `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}h`;

    gerarGrafico();
  }

  // CHART

  let chart;

  function gerarGrafico(){

    const ctx =
    document.getElementById('graficoHoras');

    const labels =
    tempos.map((_,i)=>`Sessão ${i+1}`);

    const data =
    tempos.map(t=>{

      const p = t.horas.split(':');

      return (
        Number(p[0]) +
        Number(p[1])/60
      );
    });

    if(chart){
      chart.destroy();
    }

    chart = new Chart(ctx,{
      type:'line',
      data:{
        labels,
        datasets:[{
          label:'Horas Estudadas',
          data
        }]
      }
    });
  }

  renderEditais();
  renderMaterias();
  renderTempo();
  renderTasks();
  atualizarDashboard();

</script>

</body>
</html>
